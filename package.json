{
  "name": "asepsico",
  "version": "1.0.0-alpha.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @asepsico/api run start:dev",
    "dev:web": "npm --workspace @asepsico/web run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm --workspace @asepsico/api run prisma:generate",
    "db:migrate": "npm --workspace @asepsico/api run prisma:migrate",
    "db:seed": "npm --workspace @asepsico/api run prisma:seed",
    "db:encrypt-fields": "npm --workspace @asepsico/api run db:encrypt-fields --",
    "waitlist:export": "npm --workspace @asepsico/api run waitlist:export --",
    "waitlist:delete": "npm --workspace @asepsico/api run waitlist:delete --",
    "waitlist:purge": "npm --workspace @asepsico/api run waitlist:purge --",
    "waitlist:confirm-commercial": "npm --workspace @asepsico/api run waitlist:confirm-commercial --",
    "waitlist:withdraw-commercial": "npm --workspace @asepsico/api run waitlist:withdraw-commercial --",
    "invites:create": "npm --workspace @asepsico/api run invites:create --",
    "db:seed-demo-workspace": "npm --workspace @asepsico/api run db:seed-demo-workspace --",
    "db:purge-demo-workspace": "npm --workspace @asepsico/api run db:purge-demo-workspace --",
    "test:smoke": "node scripts/smoke-live.mjs",
    "db:migrate:ci": "npm --workspace @asepsico/api run prisma:migrate:deploy",
    "test:ci-config": "node scripts/verify-ci-postgres.mjs",
    "test:landing": "node scripts/check-landing.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true
  }
}
