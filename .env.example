DATABASE_URL=postgresql://asepsico:asepsico@localhost:5432/asepsico?schema=public
JWT_SECRET=change-this-in-production-with-at-least-32-characters
# Secreto DISTINTO al de arriba a propósito: los tokens del portal del paciente y los de
# staff son dominios de confianza separados. Si compartieran secreto y el lado de staff no
# comprobara el "kind" del token, un paciente podría reutilizar su propio token de portal
# como si fuera un token de staff. Genera un valor distinto, no reutilices JWT_SECRET aquí.
PORTAL_JWT_SECRET=change-this-too-to-a-different-random-value-at-least-32-chars
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NODE_ENV=development
# Cifrado de campos clínicos (AES-256-GCM). Obligatorio en producción. Genera cada clave con
#   openssl rand -base64 32
# y guárdala en el gestor de secretos, nunca en el repo. Vacío en local = clave de desarrollo.
# FIELD_ENCRYPTION_KEY: clave de los valores "enc:v1:" (formato histórico). Mantenla mientras
# quede algún valor v1 en la base de datos.
FIELD_ENCRYPTION_KEY=
# Rotación (opcional): llavero "kid:clave,kid2:clave2" y kid con el que se escribe ("enc:v2:<kid>:").
# Si FIELD_ENCRYPTION_KEYS está vacío se sigue escribiendo v1 con FIELD_ENCRYPTION_KEY.
# Tras cambiar la clave activa: npm run db:encrypt-fields -- --rotate
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KID=
# Dejar vacío en local. En producción, dominio del que cuelgan web y api (p.ej. .asepsico.es)
# para que las cookies de sesión se compartan correctamente entre subdominios.
COOKIE_DOMAIN=
# Proxies de confianza delante de la API (Express "trust proxy"); decide qué IP usa el rate
# limiting de /auth/* (req.ip). Vacío = 1 salto si NODE_ENV=production (proxy de Render), y
# desactivado en local/test. Valores: entero 1..5 (saltos), "false", o lista separada por comas
# de IPs/subredes CIDR/loopback/linklocal/uniquelocal. "true" se rechaza al arrancar (permitiría
# falsear la IP con X-Forwarded-For). Producción en Render: 1. Ver ops/PILOT_RUNBOOK.md.
TRUST_PROXY=
