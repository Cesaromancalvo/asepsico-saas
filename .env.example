# Landing pública (apps/landing, Render Static Site, NO esta API): su build (node build.mjs)
# rellena el NIF y el domicilio del aviso legal con LEGAL_TITULAR_NIF y LEGAL_TITULAR_DOMICILIO,
# definidas SOLO en el Environment del Static Site. No hacen falta en local salvo para probar el
# build con datos ficticios. Ver apps/landing/README.md, apartado "Datos del titular".
DATABASE_URL=postgresql://asepsico:asepsico@localhost:5432/asepsico?schema=public
JWT_SECRET=change-this-in-production-with-at-least-32-characters
# Secreto DISTINTO al de arriba a propósito: los tokens del portal del paciente y los de
# staff son dominios de confianza separados. Si compartieran secreto y el lado de staff no
# comprobara el "kind" del token, un paciente podría reutilizar su propio token de portal
# como si fuera un token de staff. Genera un valor distinto, no reutilices JWT_SECRET aquí.
PORTAL_JWT_SECRET=change-this-too-to-a-different-random-value-at-least-32-chars
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NODE_ENV=development
# Contraseña de la cuenta demo del seed de desarrollo (npm run db:seed), mínimo 12 caracteres.
# Vacía = el seed genera una aleatoria y la imprime una vez. El seed se niega a ejecutarse con
# NODE_ENV=production o contra una BD no local (salvo --allow-production-seed).
SEED_DEMO_PASSWORD=
# Cifrado de campos clínicos (AES-256-GCM). Obligatorio en producción. Genera cada clave con
#   openssl rand -base64 32
# y guárdala en el gestor de secretos, nunca en el repo. Vacío en local = clave de desarrollo.
# FIELD_ENCRYPTION_KEY: clave de los valores "enc:v1:" (formato histórico). Mantenla mientras
# quede algún valor v1 en la base de datos.
FIELD_ENCRYPTION_KEY=
# Rotación (opcional): llavero "kid:clave,kid2:clave2" y kid con el que se escribe ("enc:v2:<kid>:").
# Si FIELD_ENCRYPTION_KEYS está vacío se sigue escribiendo v1 con FIELD_ENCRYPTION_KEY.
# Tras cambiar la clave activa: npm run db:encrypt-fields -- --rotate
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KID=
# Dejar vacío en local. En producción, dominio del que cuelgan web y api (p.ej. .asepsico.es)
# para que las cookies de sesión se compartan correctamente entre subdominios.
COOKIE_DOMAIN=
# Proxies de confianza delante de la API (Express "trust proxy"); decide qué IP usa el rate
# limiting de /auth/* (req.ip). Vacío = 1 salto si NODE_ENV=production (proxy de Render), y
# desactivado en local/test. Valores: entero 1..5 (saltos), "false", o lista separada por comas
# de IPs/subredes CIDR/loopback/linklocal/uniquelocal. "true" se rechaza al arrancar (permitiría
# falsear la IP con X-Forwarded-For). Producción en Render: 1. Ver ops/PILOT_RUNBOOK.md.
TRUST_PROXY=
# Lista de espera pública (POST /api/v1/public/waitlist, llamada desde la landing asepsico.es).
# Orígenes del navegador admitidos SOLO en ese endpoint (CORS + comprobación de Origin), separados
# por comas, sin ruta. Vacío = https://asepsico.es,https://www.asepsico.es. En local, para probar
# la landing servida en http://localhost:8080: WAITLIST_ALLOWED_ORIGINS=http://localhost:8080
WAITLIST_ALLOWED_ORIGINS=
# Secreto (>= 32 caracteres, openssl rand -base64 32) del hash de deduplicación del email y de la
# firma del token de formulario. Obligatorio en producción (la API no arranca sin él). No lo rotes
# sin plan: cambiarlo hace que las altas previas dejen de deduplicarse y de encontrarse con
# npm run waitlist:delete. Vacío en local = secreto de desarrollo.
WAITLIST_SECRET=
# Aviso por correo al Jefe de las altas en la lista de espera (sin datos del apuntado). Apagado
# por defecto. Con WAITLIST_NOTIFY_ENABLED=true la API no arranca si falta alguna variable (el
# error solo nombra las variables, nunca sus valores). Proveedor actual: Scaleway Transactional
# Email (fr-par). Valores reales SOLO en el panel de Render, nunca aquí. Ver ops/PILOT_RUNBOOK.md.
WAITLIST_NOTIFY_ENABLED=false
# Uno o varios destinatarios INTERNOS separados por comas (el servicio de correo rechaza cualquier otro).
WAITLIST_NOTIFY_TO=
# Scaleway: smtp.tem.scaleway.com; 587 (STARTTLS exigido) o 465 (TLS). Otros puertos no se admiten.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
# Scaleway: usuario = ID del proyecto; contraseña = clave secreta de una API key (permiso
# TransactionalEmail solo para el proyecto de producción).
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
# Remitente de un dominio verificado en el proveedor, p. ej. "AsePsico <avisos@notificaciones.asepsico.es>"
MAIL_FROM=
# Condiciones legales (apps/api/src/legal/). Con NODE_ENV=production, si algún documento vigente
# conserva un marcador sin rellenar ([NIF], [DOMICILIO], [PENDIENTE DEL DESPACHO]...), registro,
# alta de miembros y aceptación responden 503 LEGAL_TERMS_DRAFT. No hay forma de saltarlo.
# Datos del titular que NUNCA van en git (el repo es público): se ponen SOLO en el panel de Render
# (Environment). NIF: DNI/NIE con letra de control válida. Domicilio: una línea, 10-200 caracteres.
# Vacíos o mal formados = el marcador se queda y los textos cuentan como borrador.
LEGAL_TITULAR_NIF=
LEGAL_TITULAR_DOMICILIO=
# Aviso fijo "Entorno de prueba: usa solo datos inventados" en la web (GET /api/v1/environment).
# Solo "false" exacto lo quita; vacío o cualquier otro valor lo muestra. Piloto demo: true.
DEMO_ENVIRONMENT=true
