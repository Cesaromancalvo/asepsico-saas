generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  THERAPIST
  ASSISTANT
}

/// Estado de la membresía. REMOVED = dado de baja: la fila se conserva (autoría y auditoría) y
/// pierde todo acceso al espacio.
enum WorkspaceMemberStatus {
  ACTIVE
  REMOVED
}

/// Motivo de baja de un miembro, de lista cerrada (opcional). Sin texto libre.
enum MemberRemovalReason {
  LEFT_PRACTICE
  END_OF_COLLABORATION
  LEAVE_OF_ABSENCE
  OTHER
}

enum PatientStatus {
  ACTIVE
  PAUSED
  DISCHARGED
  ARCHIVED
  BLOCKED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ClinicalProcessStatus {
  ACTIVE
  PAUSED
  DISCHARGED
  CLOSED
}

enum TherapyModality {
  IN_PERSON
  ONLINE
  HYBRID
}

enum TherapyGoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  CANCELLED
}

enum TherapeuticTaskStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  SUBMITTED
  CHANGES_REQUESTED
  COMPLETED
  CANCELLED
}

enum PatientDocumentType {
  CLINICAL
  REFERRAL
  ADMINISTRATIVE
  EXTERNAL_REPORT
  OTHER
}

enum ConsentType {
  DATA_PROCESSING
  INFORMED_CONSENT
  TELEPSYCHOLOGY
  MINOR_GUARDIAN
  COMMUNICATIONS
  OTHER
}

enum ConsentStatus {
  PENDING
  SIGNED
  REVOKED
  EXPIRED
}

enum ClinicalReportType {
  EVOLUTION
  DISCHARGE
  REFERRAL
  CERTIFICATE
  CUSTOM
}

enum ClinicalReportStatus {
  DRAFT
  FINAL
  VOID
}

enum ResourceType {
  LINK
  FILE
}

enum ResourceCategory {
  PSYCHOEDUCATION
  EXERCISE
  WORKSHEET
  AUDIO
  VIDEO
  READING
  OTHER
}

/// Documentos legales que acepta el titular de la consulta (versionados en src/legal/).
enum LegalDocumentType {
  PILOT_TERMS
  DPA_ART28
  PRIVACY_PRODUCT
}

enum SessionType {
  INDIVIDUAL
  COUPLE
  FAMILY
  GROUP
  FOLLOW_UP
  ASSESSMENT
}

model Workspace {
  id                          String                           @id @default(cuid())
  name                        String
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  members                     WorkspaceMember[]
  patients                    Patient[]
  sessions                    Session[]
  auditLogs                   AuditLog[]
  clinicalProcesses           ClinicalProcess[]
  patientDocuments            PatientDocument[]
  consentRecords              ConsentRecord[]
  clinicalReports             ClinicalReport[]
  invoices                    Invoice[]
  payments                    Payment[]
  portalAccounts              PatientPortalAccount[]
  therapeuticResources        TherapeuticResource[]
  resourceShares              ResourceShare[]
  conversations               Conversation[]
  patientImportJobs           PatientImportJob[]
  patientImportItems          PatientImportItem[]
  termsAcceptances            TermsAcceptance[]
  workspaceInvites            WorkspaceInvite[]
  registrationInvite          RegistrationInvite?
  clinicalProcessOpenings     ClinicalProcessOpening[]
  exceptionalAccesses         ExceptionalAccessJustification[]
  exceptionalAccessMisses     ExceptionalAccessReasonMiss?
  /// Zona horaria IANA del espacio: los huecos de la reserva desde el portal se calculan en hora
  /// local (con cambios de horario de verano e invierno).
  timeZone                    String                           @default("Europe/Madrid")
  therapistAvailabilities     TherapistAvailability[]
  availabilityWindows         AvailabilityWindow[]
  availabilityBlocks          AvailabilityBlock[]
  appointmentRequests         AppointmentRequest[]
  clinicalProcessPrivateNotes ClinicalProcessPrivateNote[]
}

model User {
  id                           String                       @id @default(cuid())
  email                        String                       @unique
  passwordHash                 String
  firstName                    String
  lastName                     String
  totpSecret                   String?
  totpEnabled                  Boolean                      @default(false)
  mfaRecoveryCodes             String[]                     @default([])
  /// Último paso TOTP (floor(epoch/30)) aceptado; impide reutilizar un código (RFC 6238 §5.2).
  totpLastUsedStep             Int?
  /// Fallos de segundo factor seguidos (se pone a 0 con cualquier verificación correcta).
  mfaFailedAttempts            Int                          @default(0)
  /// Espera temporal tras varios fallos seguidos. Nunca es un bloqueo permanente.
  mfaLockedUntil               DateTime?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  memberships                  WorkspaceMember[]
  auditLogs                    AuditLog[]                   @relation("AuditActor")
  refreshTokens                RefreshToken[]
  sessionsAsTherapist          Session[]
  clinicalProcessesAsTherapist ClinicalProcess[]
  patientDocumentsCreated      PatientDocument[]
  consentRecordsCreated        ConsentRecord[]
  clinicalReportsCreated       ClinicalReport[]
  invoicesCreated              Invoice[]
  paymentsRecorded             Payment[]
  resourcesCreated             TherapeuticResource[]
  messagesSent                 Message[]
  patientImportJobs            PatientImportJob[]
  termsAcceptances             TermsAcceptance[]
  workspaceInvitesSent         WorkspaceInvite[]            @relation("WorkspaceInviteInvitedBy")
  workspaceInvitesAccepted     WorkspaceInvite[]            @relation("WorkspaceInviteAcceptedUser")
  registrationInviteUsed       RegistrationInvite?          @relation("RegistrationInviteUsedBy")
  availabilitySettings         TherapistAvailability[]
  availabilityWindows          AvailabilityWindow[]
  availabilityBlocks           AvailabilityBlock[]
  appointmentRequests          AppointmentRequest[]
  clinicalProcessPrivateNotes  ClinicalProcessPrivateNote[]
  /// Usuario ficticio creado por db:seed-demo-workspace (Recepción Demo, Terapeuta Demo). Solo lo
  /// borra db:purge-demo-workspace. Nunca se marca a un usuario real.
  isDemo                       Boolean                      @default(false)
  /// Versión de las credenciales. Va en el access token (claim `tv`) y JwtAuthGuard la compara en
  /// cada petición: subirla (cambio de contraseña) invalida al momento todos los access tokens vivos.
  tokenVersion                 Int                          @default(0)
  /// Último cambio de contraseña (constancia; la invalidación la hace tokenVersion).
  passwordChangedAt            DateTime?
}

/// Invitación de un solo uso para crear un workspace nuevo (registro cerrado). La crea solo la
/// plataforma (CLI con acceso a la BD), nunca un usuario. El token solo se guarda como hash.
/// No tiene workspaceId al crearse: es previa a cualquier workspace (dato de plataforma).
model RegistrationInvite {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  /// Correo destinatario, en minúsculas. El registro exige que coincida.
  email        String
  expiresAt    DateTime
  /// Quién la emitió (etiqueta libre del operador de la plataforma, p. ej. "cli:cesar").
  createdBy    String
  createdAt    DateTime   @default(now())
  usedAt       DateTime?
  revokedAt    DateTime?
  usedByUserId String?    @unique
  workspaceId  String?    @unique
  usedBy       User?      @relation("RegistrationInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([email])
}

/// Invitación de un miembro a un workspace existente. Rol e isClinician quedan fijados por el
/// OWNER al invitar (CHECK en la BD: THERAPIST siempre clínico, ASSISTANT nunca, nunca OWNER).
model WorkspaceInvite {
  id             String        @id @default(cuid())
  workspaceId    String
  tokenHash      String        @unique
  email          String
  role           WorkspaceRole
  isClinician    Boolean
  invitedById    String?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy      User?         @relation("WorkspaceInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedUser   User?         @relation("WorkspaceInviteAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([email])
}

/// Evidencia de aceptación de un documento legal en una versión concreta (hash del texto exacto).
/// Se conserva aunque cambie la versión vigente: es la prueba de qué se aceptó y cuándo.
/// RESTRICT a propósito: la evidencia se conserva frente a la supresión (art. 17.3.e RGPD).
/// TODO(supresión): el futuro flujo de supresión de cuentas seudonimiza el User, nunca lo borra
/// (ver docs/SECURITY_BASELINE.md, "Registro por invitación y aceptación de condiciones").
model TermsAcceptance {
  id           String            @id @default(cuid())
  workspaceId  String
  userId       String
  documentType LegalDocumentType
  version      String
  /// SHA-256 (hex) del texto exacto aceptado.
  textHash     String
  acceptedAt   DateTime          @default(now())
  ipAddress    String?
  userAgent    String?
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Incluye el hash: si el texto cambia (aunque no cambie la versión) hay que volver a aceptarlo.
  @@unique([workspaceId, userId, documentType, version, textHash])
  @@index([workspaceId, documentType, version])
}

model WorkspaceMember {
  id                    String                @id @default(cuid())
  workspaceId           String
  userId                String
  role                  WorkspaceRole         @default(THERAPIST)
  /// Profesional clínico: puede tratar pacientes. No da acceso por sí solo: el contenido clínico
  /// exige además un proceso ACTIVO con el paciente (o ser autor de un proceso cerrado, solo lo suyo).
  /// Solo es configurable en OWNER/ADMIN (lo cambia el OWNER): THERAPIST siempre es clínico y
  /// ASSISTANT nunca (ambas cosas con CHECK en la base de datos).
  isClinician           Boolean               @default(false)
  createdAt             DateTime              @default(now())
  onboardingStep        Int                   @default(0)
  onboardingCompletedAt DateTime?
  onboardingDismissedAt DateTime?
  /// Baja del miembro (historia B). REMOVED ⇔ removedAt no nulo (CHECK en la BD). Nunca se borra
  /// la fila: lo que escribió sigue firmado con su nombre. JwtAuthGuard rechaza a un REMOVED.
  status                WorkspaceMemberStatus @default(ACTIVE)
  removedAt             DateTime?
  /// Quién le dio de baja (userId del OWNER/ADMIN). Sin FK: constancia aunque cambie el equipo.
  removedById           String?
  removalReason         MemberRemovalReason?
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, status])
}

model Patient {
  id                  String                 @id @default(cuid())
  workspaceId         String
  firstName           String
  lastName            String
  email               String?
  phone               String?
  birthDate           DateTime?
  consultationReason  String?
  status              PatientStatus          @default(ACTIVE)
  portalAccessMode    PortalAccessMode       @default(PATIENT_ONLY)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  blockedAt           DateTime?
  retentionUntil      DateTime?
  /// Paciente inventado sembrado por db:seed-demo-workspace. db:purge-demo-workspace borra SOLO
  /// pacientes con isDemo=true (y todo lo que cuelga de ellos). Nunca se marca a un paciente real.
  isDemo              Boolean                @default(false)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sessions            Session[]
  clinicalProcesses   ClinicalProcess[]
  clinicalHistory     ClinicalHistory?
  therapyGoals        TherapyGoal[]
  therapeuticTasks    TherapeuticTask[]
  clinicalAssessments ClinicalAssessment[]
  patientDocuments    PatientDocument[]
  consentRecords      ConsentRecord[]
  clinicalReports     ClinicalReport[]
  invoices            Invoice[]
  payments            Payment[]
  portalAccounts      PatientPortalAccount[]
  resourceShares      ResourceShare[]
  conversations       Conversation[]
  importItem          PatientImportItem?
  appointmentRequests AppointmentRequest[]

  @@index([workspaceId, status])
  @@index([workspaceId, lastName, firstName])
  @@index([workspaceId, isDemo])
}

model ClinicalHistory {
  id                    String   @id @default(cuid())
  patientId             String   @unique
  reasonForConsultation String?
  currentProblem        String?
  personalHistory       String?
  familyHistory         String?
  medicalHistory        String?
  currentMedication     String?
  primaryDiagnosis      String?
  riskFactors           String?
  protectiveFactors     String?
  clinicalObservations  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model TherapyGoal {
  id          String            @id @default(cuid())
  patientId   String
  title       String
  description String?
  status      TherapyGoalStatus @default(ACTIVE)
  targetDate  DateTime?
  achievedAt  DateTime?
  priority    Int               @default(2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tasks       TherapeuticTask[]

  @@index([patientId, status])
  @@index([patientId, priority])
}

model TherapeuticTaskTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  instructions String?
  category     String?
  isActive     Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, isActive])
  @@index([workspaceId, title])
}

model TherapeuticTask {
  id              String                @id @default(cuid())
  patientId       String
  therapyGoalId   String?
  sessionId       String?
  title           String
  instructions    String?
  status          TherapeuticTaskStatus @default(PENDING)
  dueDate         DateTime?
  assignedAt      DateTime?
  startedAt       DateTime?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  completedAt     DateTime?
  patientFeedback String?
  clinicianNotes  String?
  reviewComment   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  patient         Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapyGoal     TherapyGoal?          @relation(fields: [therapyGoalId], references: [id], onDelete: SetNull)
  session         Session?              @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([patientId, status])
  @@index([patientId, dueDate])
  @@index([therapyGoalId])
  @@index([sessionId])
}

model ClinicalAssessment {
  id             String   @id @default(cuid())
  patientId      String
  scaleCode      String
  scaleName      String
  answers        Json
  // Puntuación, gravedad y alerta de riesgo cifradas juntas: JSON {totalScore, severity, riskFlag}
  // cifrado con encryptField (ver src/common/crypto/clinical-crypto.ts).
  result         String?
  interpretation String
  clinicalNotes  String?
  administeredAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, administeredAt])
  @@index([patientId, scaleCode])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  tokenHash   String    @unique
  family      String
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  createdAt   DateTime  @default(now())
  ipAddress   String?
  userAgent   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}

model Session {
  id                String        @id @default(cuid())
  workspaceId       String
  patientId         String
  therapistId       String
  clinicalProcessId String?
  startsAt          DateTime
  endsAt            DateTime
  status            SessionStatus @default(SCHEDULED)
  type              SessionType   @default(INDIVIDUAL)
  location          String?
  videoCallUrl      String?
  notes             String?
  internalSummary   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  therapist        User              @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  clinicalProcess  ClinicalProcess?  @relation(fields: [clinicalProcessId], references: [id], onDelete: SetNull)
  therapeuticTasks TherapeuticTask[]

  @@index([workspaceId, startsAt])
  @@index([therapistId, startsAt])
  @@index([patientId, startsAt])
  @@index([clinicalProcessId, startsAt])
}

model ClinicalProcess {
  id                 String                @id @default(cuid())
  workspaceId        String
  patientId          String
  therapistId        String
  title              String
  consultationReason String?
  goals              String?
  internalNotes      String?
  modality           TherapyModality       @default(IN_PERSON)
  frequency          String?
  status             ClinicalProcessStatus @default(ACTIVE)
  startedAt          DateTime              @default(now())
  endedAt            DateTime?
  /// Momento en que pasó a PAUSED (fin de la ventana de mensajes mientras está en pausa).
  pausedAt           DateTime?
  /// Motivo de apertura cuando el proceso se abrió sobre historia ajena (H6, acceso excepcional).
  /// null en las altas normales y en los procesos anteriores a esta columna.
  openingReasonCode  ProcessOpeningReason?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace    Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient      Patient                      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  therapist    User                         @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  sessions     Session[]
  importItem   PatientImportItem?
  privateNotes ClinicalProcessPrivateNote[]

  @@index([workspaceId, status])
  @@index([patientId, status])
  @@index([therapistId, status])
}

model TherapeuticResource {
  id          String           @id @default(cuid())
  workspaceId String
  title       String
  description String?
  type        ResourceType
  category    ResourceCategory @default(OTHER)
  url         String?
  fileName    String?
  mimeType    String?
  storageKey  String?
  createdById String
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  shares      ResourceShare[]

  @@index([workspaceId, archivedAt, category])
  @@index([workspaceId, title])
}

model ResourceShare {
  id          String              @id @default(cuid())
  workspaceId String
  resourceId  String
  patientId   String
  sharedAt    DateTime            @default(now())
  revokedAt   DateTime?
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  resource    TherapeuticResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([resourceId, patientId])
  @@index([workspaceId, patientId, revokedAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model PatientDocument {
  id          String              @id @default(cuid())
  workspaceId String
  patientId   String
  title       String
  type        PatientDocumentType
  description String?
  fileName    String?
  mimeType    String?
  storageKey  String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, patientId, createdAt])
}

model ConsentRecord {
  id          String        @id @default(cuid())
  workspaceId String
  patientId   String
  type        ConsentType
  title       String
  status      ConsentStatus @default(PENDING)
  signedAt    DateTime?
  expiresAt   DateTime?
  signedBy    String?
  notes       String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, patientId, status])
}

model ClinicalReport {
  id          String               @id @default(cuid())
  workspaceId String
  patientId   String
  title       String
  type        ClinicalReportType
  status      ClinicalReportStatus @default(DRAFT)
  content     String
  finalizedAt DateTime?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, patientId, status])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  BIZUM
  DIRECT_DEBIT
  OTHER
}

model Invoice {
  id            String        @id @default(cuid())
  workspaceId   String
  patientId     String
  sequence      Int
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("EUR")
  issueDate     DateTime?
  dueDate       DateTime?
  subtotalCents Int
  taxCents      Int           @default(0)
  totalCents    Int
  paidCents     Int           @default(0)
  notes         String?
  voidReason    String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines         InvoiceLine[]
  payments      Payment[]

  @@unique([workspaceId, sequence])
  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, status, dueDate])
  @@index([patientId, createdAt])
}

model InvoiceLine {
  id                String   @id @default(cuid())
  invoiceId         String
  description       String
  quantity          Int      @default(1)
  unitPriceCents    Int
  taxRateBps        Int      @default(0)
  lineSubtotalCents Int
  lineTaxCents      Int
  lineTotalCents    Int
  createdAt         DateTime @default(now())
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  workspaceId    String
  patientId      String
  invoiceId      String
  amountCents    Int
  method         PaymentMethod
  paidAt         DateTime      @default(now())
  reference      String?
  idempotencyKey String?
  notes          String?
  recordedById   String
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy     User          @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, paidAt])
  @@index([invoiceId, paidAt])
  @@index([patientId, paidAt])
}

model PatientPortalAccount {
  id                   String             @id @default(cuid())
  workspaceId          String
  patientId            String
  accessorType         PortalAccessorType @default(PATIENT)
  guardianName         String?
  guardianRelationship String?
  email                String
  passwordHash         String
  isActive             Boolean            @default(true)
  mustChangePassword   Boolean            @default(true)
  failedLoginAttempts  Int                @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient              Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([email])
  @@index([workspaceId, isActive])
  @@index([patientId])
}

enum NotificationAudience {
  PROFESSIONAL
  PATIENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  CANCELLED
  FAILED
}

enum NotificationType {
  APPOINTMENT_REMINDER
  TASK_DUE
  CONSENT_EXPIRING
  INVOICE_DUE
  SYSTEM
  /// Aviso al terapeuta titular: acceso excepcional o apertura de proceso sobre su historia.
  /// Sin texto clínico ni explicación: persona, rol, iniciales del paciente y motivo.
  CLINICAL_ACCESS_NOTICE
  APPOINTMENT_REQUEST
  APPOINTMENT_REQUEST_UPDATE
}

enum PortalAccessMode {
  PATIENT_ONLY
  GUARDIAN_ONLY
  SHARED
}

enum PortalAccessorType {
  PATIENT
  GUARDIAN
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  workspaceId          String
  patientId            String?  @unique
  userId               String?  @unique
  appointmentReminders Boolean  @default(true)
  taskReminders        Boolean  @default(true)
  consentReminders     Boolean  @default(true)
  invoiceReminders     Boolean  @default(true)
  emailEnabled         Boolean  @default(false)
  smsEnabled           Boolean  @default(false)
  reminderHoursBefore  Int      @default(24)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([workspaceId])
}

model Notification {
  id          String                 @id @default(cuid())
  workspaceId String
  audience    NotificationAudience
  userId      String?
  patientId   String?
  type        NotificationType
  title       String
  body        String
  actionUrl   String?
  status      NotificationStatus     @default(PENDING)
  scheduledAt DateTime
  sentAt      DateTime?
  readAt      DateTime?
  dedupeKey   String                 @unique
  metadata    Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deliveries  NotificationDelivery[]

  @@index([workspaceId, audience, status, scheduledAt])
  @@index([userId, status, createdAt])
  @@index([patientId, status, createdAt])
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  providerRef    String?
  attemptedAt    DateTime?
  errorCode      String?
  createdAt      DateTime            @default(now())
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageSenderType {
  PROFESSIONAL
  PATIENT
}

model Conversation {
  id              String             @id @default(cuid())
  workspaceId     String
  patientId       String
  status          ConversationStatus @default(OPEN)
  patientCanReply Boolean            @default(true)
  closedAt        DateTime?
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([workspaceId, patientId])
  @@index([workspaceId, status, updatedAt])
  @@index([patientId, updatedAt])
}

model Message {
  id                   String            @id @default(cuid())
  conversationId       String
  senderType           MessageSenderType
  senderUserId         String?
  body                 String
  attachmentName       String?
  attachmentKey        String?
  mimeType             String?
  readByProfessionalAt DateTime?
  readByPatientAt      DateTime?
  createdAt            DateTime          @default(now())
  conversation         Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser           User?             @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
}

// ─── Importación de pacientes (docs/producto/importacion-pacientes-csv.md) ───────────────────

enum PatientImportStatus {
  UPLOADED // fichero leído y guardado cifrado; falta el mapeo
  PREVIEWED // mapeo guardado; se puede confirmar
  PROCESSING // confirmación en curso (bloqueo optimista frente a dobles confirmaciones)
  COMPLETED
  PARTIAL // falló un bloque; se puede reintentar la confirmación (reanuda en el cursor)
  CANCELLED
  EXPIRED // pasaron 24 h sin confirmar: el fichero se borró
  REVERTING // deshacer en curso (bloqueo optimista frente a reverts o reintentos simultáneos)
  REVERTED
}

/// Un lote de importación. Nunca guarda valores de celdas en claro: la tabla leída del fichero
/// va cifrada en `payload` y se borra al terminar, al cancelar o a las 24 horas. `mapping`,
/// `plan` y `errorReport` solo contienen índices, números de fila, nombres de campo y códigos.
model PatientImportJob {
  id               String              @id @default(cuid())
  workspaceId      String
  /// null si se suprime el usuario de staff que importó (el lote y su auditoría se conservan).
  importerId       String?
  status           PatientImportStatus @default(UPLOADED)
  format           String
  payload          String?
  payloadExpiresAt DateTime?
  mapping          Json?
  plan             Json?
  errorReport      Json?
  totalRows        Int                 @default(0)
  cursor           Int                 @default(0)
  createdCount     Int                 @default(0)
  completedCount   Int                 @default(0)
  skippedCount     Int                 @default(0)
  errorCount       Int                 @default(0)
  revertedCount    Int                 @default(0)
  confirmedAt      DateTime?
  finishedAt       DateTime?
  revertibleUntil  DateTime?
  revertedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  importer         User?               @relation(fields: [importerId], references: [id], onDelete: SetNull)
  items            PatientImportItem[]

  @@index([workspaceId, importerId, createdAt])
  @@index([status, payloadExpiresAt])
}

/// Paciente creado por un lote (para deshacerlo). Solo ids y número de fila.
model PatientImportItem {
  id                String           @id @default(cuid())
  workspaceId       String
  jobId             String
  patientId         String           @unique
  clinicalProcessId String           @unique
  rowNumber         Int
  createdAt         DateTime         @default(now())
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  job               PatientImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicalProcess   ClinicalProcess  @relation(fields: [clinicalProcessId], references: [id], onDelete: Cascade)

  @@index([workspaceId, jobId])
}

// ---------------------------------------------------------------------------------------------
// Lista de espera pública de asepsico.es (profesionales de la psicología). NO pertenece a ningún
// workspace: es anterior a tener cuenta y no contiene datos de salud ni de pacientes.
// name/email/tools van cifrados en reposo (registro en common/crypto/clinical-crypto.ts).
// emailHash = HMAC-SHA256 del email normalizado con una clave derivada de WAITLIST_SECRET: sirve
// para deduplicar sin guardar el email en claro. No se guarda IP ni user-agent.
// Supresión (art. 17 RGPD): se vacían todos los datos personales (incluido emailHash) y queda
// solo deletedAt; ver prisma/scripts/waitlist-delete.ts.
// ---------------------------------------------------------------------------------------------

enum WaitlistSituation {
  SELF_EMPLOYED
  PRACTICE
  STUDENT
  OTHER
}

enum WaitlistSource {
  INSTAGRAM
  COLLEAGUE
  PROFESSIONAL_COLLEGE
  SEARCH_ENGINE
  OTHER
  NOT_SAID
}

model WaitlistEntry {
  id                           String             @id @default(cuid())
  /// Cifrado (enc:v1/v2). Null tras la supresión.
  name                         String?
  /// Cifrado (enc:v1/v2). Null tras la supresión.
  email                        String?
  /// HMAC del email normalizado. Null tras la supresión (Postgres admite varios NULL en un UNIQUE).
  emailHash                    String?            @unique
  situation                    WaitlistSituation?
  /// Texto libre cifrado: herramientas que usa hoy.
  tools                        String?
  professionalsCount           Int?
  source                       WaitlistSource?
  privacyPolicyVersion         String
  privacyAcceptedAt            DateTime
  /// El formulario solo registra que se MARCÓ la casilla comercial (y cuándo). No es un consentimiento
  /// válido: falta el doble opt-in (confirmación por email, de momento manual con waitlist:confirm-commercial).
  commercialConsentRequested   Boolean            @default(false)
  commercialConsentRequestedAt DateTime?
  /// Consentimiento comercial VÁLIDO: solo lo activa waitlist:confirm-commercial tras la respuesta "Sí".
  commercialConsent            Boolean            @default(false)
  commercialConsentAt          DateTime?
  /// Retirada (waitlist:withdraw-commercial o enlace de baja futuro); nunca desde el formulario.
  commercialConsentWithdrawnAt DateTime?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  deletedAt                    DateTime?

  @@index([deletedAt, createdAt])
}

// --- Acceso excepcional (docs/producto/acceso-excepcional.md) -------------------------------

/// Motivo cerrado para abrir o reactivar un proceso sobre historia ajena (H6). Sin "Otro".
enum ProcessOpeningReason {
  SUBSTITUTION
  TRANSFER_ON_LEAVE
  PATIENT_REQUESTED_CHANGE
  REFERRAL
}

enum ProcessOpeningKind {
  OPENED
  REACTIVATED
}

/// Resultado de la revisión posterior del OWNER (sin texto).
enum OwnerReviewOutcome {
  CORRECT
  INCIDENT
}

/// Apertura o reactivación de un proceso sobre historia ajena (H6). Solo ids y códigos, nunca
/// texto. Sin claves ajenas a paciente/proceso a propósito: el registro sobrevive a su borrado.
model ClinicalProcessOpening {
  id                   String               @id @default(cuid())
  workspaceId          String
  patientId            String
  clinicalProcessId    String
  actorId              String
  actorRole            WorkspaceRole
  targetTherapistId    String
  kind                 ProcessOpeningKind
  reasonCode           ProcessOpeningReason
  /// El OWNER/ADMIN se lo abrió a sí mismo: entra en la revisión de 72 h.
  selfAssigned         Boolean
  /// Número de OWNER del workspace al crearse (C4: decide quién puede revisar).
  ownerCountAtCreation Int
  ownerReviewDueAt     DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewOutcome        OwnerReviewOutcome?
  selfReview           Boolean?
  createdAt            DateTime             @default(now())
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, patientId])
  @@index([workspaceId, ownerReviewDueAt])
}

/// Motivo cerrado del acceso excepcional (7 códigos, sin "Otro"). Ver exceptional-access.policy.ts.
enum ExceptionalAccessReason {
  CONTINUITY_OF_CARE
  VITAL_URGENCY
  PATIENT_RIGHTS_REQUEST
  LEGAL_REQUIREMENT
  CLAIM_DEFENCE
  CUSTODY
  DATA_INCIDENT
}

/// Acceso excepcional a la historia de un paciente (H1–H5). La explicación va CIFRADA y nunca
/// sale en AuditLog, logs ni exportación ordinaria. Concede EXCEPTIONAL (solo lectura, sin notas
/// internas) mientras: no esté cerrado ni bloqueado, no haya vencido `expiresAt`, la sesión
/// `authSessionId` siga viva y sea la de la petición, el paciente no esté borrado y el actor siga
/// siendo OWNER/ADMIN. Sin claves ajenas a paciente/usuario a propósito: sobrevive a su borrado.
model ExceptionalAccessJustification {
  id                         String                  @id @default(cuid())
  workspaceId                String
  patientId                  String
  actorId                    String
  actorRole                  WorkspaceRole
  actorIsClinician           Boolean
  reasonCode                 ExceptionalAccessReason
  /// Explicación administrativa (20–300 caracteres), cifrada con el cifrado de campos.
  justification              String
  clinicalTermWarningIgnored Boolean                 @default(false)
  /// Familia del refresh token (claim `sid` del access token). null = no concede (migrados).
  authSessionId              String?
  createdAt                  DateTime                @default(now())
  expiresAt                  DateTime
  closedAt                   DateTime?
  /// MANUAL, LOGOUT, PATIENT_ARCHIVED (paciente archivado/borrado), PATIENT_BLOCKED, MIGRATED,
  /// MEMBER_REMOVED (baja del miembro que lo abrió).
  closeReason                String?
  retentionUntil             DateTime
  legalHold                  Boolean                 @default(false)
  ownerCountAtCreation       Int
  ownerReviewDueAt           DateTime?
  reviewedAt                 DateTime?
  reviewedById               String?
  reviewOutcome              OwnerReviewOutcome?
  selfReview                 Boolean?
  /// Aviso al titular diferido por un OWNER (§3.6). El motivo va cifrado.
  notificationDeferredAt     DateTime?
  notificationDeferredReason String?
  notificationReleasedAt     DateTime?
  lastDeferralReminderAt     DateTime?
  blockedAt                  DateTime?
  /// H5: creado a partir de un AuditLog antiguo con el motivo en claro. Nunca concede acceso.
  migratedFromAuditLogId     String?                 @unique
  workspace                  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, patientId, actorId])
  @@index([workspaceId, ownerReviewDueAt])
  @@index([authSessionId])
}

/// CA1.11: contador agregado del enlace "Mi motivo no está en la lista". Sin paciente, usuario ni texto.
model ExceptionalAccessReasonMiss {
  workspaceId String    @id
  count       Int       @default(0)
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------------------------------------
// Reserva de citas desde el portal (docs/producto/reserva-citas-portal.md)
// ---------------------------------------------------------------------------------------------

enum AvailabilityBlockReason {
  VACATION
  TRAINING
  PERSONAL
  OTHER
}

enum AppointmentRequestType {
  NEW
  RESCHEDULE
  CANCEL
}

enum AppointmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum AppointmentRejectionReason {
  SLOT_UNAVAILABLE
  DISCUSS_IN_SESSION
  CONTACT_PRACTICE
}

/// Ajustes de reserva desde el portal de un profesional clínico dentro de un espacio.
model TherapistAvailability {
  id                   String    @id @default(cuid())
  workspaceId          String
  therapistId          String
  /// Desactivada por defecto: solo la activan el propio profesional, OWNER o ADMIN.
  portalBookingEnabled Boolean   @default(false)
  sessionMinutes       Int       @default(50)
  breakMinutes         Int       @default(10)
  minNoticeHours       Int       @default(24)
  maxHorizonDays       Int       @default(28)
  cancelNoticeHours    Int       @default(24)
  maxPendingPerPatient Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  therapist            User      @relation(fields: [therapistId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, therapistId])
}

/// Franja semanal de consulta en hora local del espacio. weekday: 1 = lunes … 7 = domingo.
/// startMinute/endMinute: minutos desde las 00:00 (múltiplos de 15).
model AvailabilityWindow {
  id          String    @id @default(cuid())
  workspaceId String
  therapistId String
  weekday     Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  therapist   User      @relation(fields: [therapistId], references: [id], onDelete: Restrict)

  @@index([workspaceId, therapistId])
}

/// Bloqueo puntual (vacaciones, formación…). Motivo de lista cerrada, sin texto libre. El portal
/// nunca lo ve ni lo distingue de una cita.
model AvailabilityBlock {
  id          String                  @id @default(cuid())
  workspaceId String
  therapistId String
  startsAt    DateTime
  endsAt      DateTime
  reason      AvailabilityBlockReason
  createdById String?
  createdAt   DateTime                @default(now())
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  therapist   User                    @relation(fields: [therapistId], references: [id], onDelete: Restrict)

  @@index([workspaceId, therapistId, startsAt])
}

/// Solicitud de cita (nueva, cambio o cancelación) hecha desde el portal. Sin texto libre.
model AppointmentRequest {
  id                   String                      @id @default(cuid())
  workspaceId          String
  patientId            String
  therapistId          String
  clinicalProcessId    String?
  /// RESCHEDULE/CANCEL: cita afectada. NEW: cita creada al aprobar.
  sessionId            String?
  type                 AppointmentRequestType
  status               AppointmentRequestStatus    @default(PENDING)
  /// Hueco pedido (NEW/RESCHEDULE). Nulo en CANCEL.
  startsAt             DateTime?
  endsAt               DateTime?
  /// Igual a startsAt mientras la solicitud está PENDING; nulo en cuanto se resuelve. Con el índice
  /// único de abajo impide en base de datos dos solicitudes pendientes del mismo hueco (PostgreSQL
  /// trata los NULL como distintos, así que las resueltas no chocan).
  heldStartsAt         DateTime?
  requestedByAccountId String
  accessorType         PortalAccessorType
  rejectionReason      AppointmentRejectionReason?
  expiresAt            DateTime
  resolvedAt           DateTime?
  resolvedById         String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  workspace            Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient              Patient                     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  therapist            User                        @relation(fields: [therapistId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, therapistId, heldStartsAt])
  @@index([workspaceId, status, expiresAt])
  @@index([workspaceId, patientId, status])
  @@index([workspaceId, therapistId, status])
  @@index([requestedByAccountId, createdAt])
}

/// Notas internas de un profesional ANTERIOR de un proceso (historia B, veto de Argos). Al reasignar
/// un proceso, sus `internalNotes` (cifradas, sin descifrar) se trasladan aquí con su autor y el
/// campo vivo queda vacío para el nuevo profesional: ClinicalProcess.internalNotes siempre es del
/// therapistId actual. Nunca se borra; solo su autor podría leerla (hoy no hay endpoint de lectura).
model ClinicalProcessPrivateNote {
  id          String          @id @default(cuid())
  workspaceId String
  processId   String
  authorId    String
  /// Texto cifrado con el cifrado de campos (igual que internalNotes).
  notes       String
  /// Por qué se archivó (hoy solo REASSIGNED).
  reason      String          @default("REASSIGNED")
  createdAt   DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  process     ClinicalProcess @relation(fields: [processId], references: [id], onDelete: Restrict)
  author      User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, processId])
  @@index([authorId])
}
